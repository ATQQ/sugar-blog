{
  "name": "vitepress-plugin-product-card",
  "version": "0.1.1",
  "description": "VitePress plugin: markdown ::: card container + Vue product card component with GitHub time badges",
  "author": "sugar",
  "license": "MIT",
  "homepage": "https://github.com/ATQQ/sugar-blog/tree/master/packages/vitepress-plugin-product-card",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATQQ/sugar-blog.git"
  },
  "bugs": {
    "url": "https://github.com/ATQQ/sugar-blog/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "markdown-it",
    "product-card",
    "showcase",
    "github"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run /^dev:.*/",
    "dev:plugin": "npx tsup --watch",
    "dev:component": "node ../../scripts/mkdist-vue.mjs --watch --ext vue,ts --ignore index.ts,client.ts,node.ts",
    "dev:watch": "node ../../scripts/mkdist-vue.mjs --watch --ext vue,ts --ignore index.ts,client.ts,node.ts",
    "build": "pnpm run build:component && pnpm run build:plugin",
    "build:plugin": "npx tsup",
    "build:component": "node ../../scripts/mkdist-vue.mjs --ext vue,ts --ignore index.ts,client.ts,node.ts"
  },
  "peerDependencies": {
    "vitepress": "^1.0.0-0 || ^2.0.0-0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "mkdist": "^2.4.1",
    "tsup": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.24",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^2.2.12"
  }
}

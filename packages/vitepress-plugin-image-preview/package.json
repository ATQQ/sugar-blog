{
  "name": "vitepress-plugin-image-preview",
  "version": "0.1.7",
  "description": "vitepress plugin, Image Preview, 图片预览",
  "author": "sugar",
  "license": "MIT",
  "homepage": "https://github.com/ATQQ/sugar-blog/tree/master/packages/vitepress-plugin-image-preview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATQQ/sugar-blog.git"
  },
  "bugs": {
    "url": "https://github.com/ATQQ/sugar-blog/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "image",
    "preview",
    "viewer",
    "图片预览"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run /^dev:.*/",
    "dev:plugin": "npx tsup src/index.ts --dts --watch --format esm,cjs --external vitepress",
    "dev:component": "node ../../scripts/mkdist-vue.mjs --watch --ext vue,ts,svg --ignore index.ts",
    "dev:watch": "node ../../scripts/mkdist-vue.mjs --watch --ext vue,ts,svg --ignore index.ts",
    "build": "pnpm run build:component && pnpm run build:plugin",
    "build:plugin": "npx tsup src/index.ts --dts --format esm,cjs --external vitepress --silent",
    "build:component": "node ../../scripts/mkdist-vue.mjs --ext vue,ts,svg --ignore index.ts"
  },
  "peerDependencies": {
    "vitepress": "^1.0.0-0 || ^2.0.0-0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@sugarat/theme-shared": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "javascript-stringify": "^2.1.0"
  },
  "devDependencies": {
    "mkdist": "^2.4.1",
    "tsup": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.24",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^2.2.12"
  }
}

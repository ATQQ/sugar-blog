{
  "name": "vitepress-plugin-pagefind",
  "version": "0.4.25",
  "description": "vitepress plugin, Offline full-text search based on pagefind implementation.",
  "author": "sugar",
  "license": "MIT",
  "homepage": "https://github.com/ATQQ/sugar-blog/tree/master/packages/vitepress-plugin-pagefind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATQQ/sugar-blog.git"
  },
  "bugs": {
    "url": "https://github.com/ATQQ/sugar-blog/issues"
  },
  "keywords": [
    "vitepress",
    "search",
    "offline",
    "pagefind"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./Search.vue": {
      "types": "./dist/Search.vue.d.ts",
      "default": "./dist/Search.vue"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npx tsup src/index.ts --dts --watch --format esm,cjs --sourcemap",
    "build:component": "node ../../scripts/mkdist-vue.mjs --ignore index.ts",
    "build": "npm run build:component && npx tsup src/index.ts --dts --format esm,cjs --silent --sourcemap"
  },
  "peerDependencies": {
    "pagefind": "^1.1.0",
    "vitepress": "^1.0.0-0 || ^2.0.0-0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@sugarat/theme-shared": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "javascript-stringify": "^2.1.0"
  },
  "devDependencies": {
    "mkdist": "^2.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.24",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^2.2.12"
  }
}

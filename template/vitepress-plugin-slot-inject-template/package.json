{
  "name": "vitepress-plugin-slot-inject-template",
  "version": "0.1.1",
  "private": true,
  "description": "vitepress plugin, slot template",
  "author": "sugar",
  "license": "MIT",
  "homepage": "https://github.com/ATQQ/sugar-blog/tree/master/template/vitepress-plugin-slot-inject-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATQQ/sugar-blog.git"
  },
  "bugs": {
    "url": "https://github.com/ATQQ/sugar-blog/issues"
  },
  "keywords": [
    "vitepress",
    "plugin",
    "slot",
    "layout",
    "template"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run /^dev:.*/",
    "dev:plugin": "npx tsup src/index.ts --dts --watch --format esm,cjs --external vitepress",
    "dev:component": "node scripts/devComponents.mjs",
    "dev:watch": "node scripts/devComponents.mjs",
    "build": "pnpm run /^build:.*/",
    "build:plugin": "npx tsup src/index.ts --dts --format esm,cjs --external vitepress --silent",
    "build:component": "mkdist --src src --dist dist --pattern '**/*.{vue,ts,css}' --declaration --format esm"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vitepress": "^1.0.0-0 || ^2.0.0-0"
  },
  "dependencies": {
    "@sugarat/theme-shared": "workspace:*",
    "javascript-stringify": "^2.1.0"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "mkdist": "^2.4.1",
    "tsup": " ^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.24",
    "vue-sfc-transformer": "^0.3.0",
    "vue-tsc": "^2.2.12"
  }
}
